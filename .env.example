# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Used by create_script.py to generate dialogue/scene data and by
# review_manifest.py to proofread the generated script, both via GPT.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ─── ElevenLabs ───────────────────────────────────────────────────────────────
# Used by create_audio.py to synthesise TTS audio for every scene.
# Get your key at https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=sk_...

# ─── fal.ai ───────────────────────────────────────────────────────────────────
# Used by create_images.py to generate scene illustrations and character/location art.
# Get your key at https://fal.ai → Dashboard → API Keys
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Facebook / Instagram app (shared Graph API app) ──────────────────────────
# Static app credentials for the Instagram publisher (upload_instagram.py) and the
# standalone Facebook Page publisher (upload_facebook.py). Set these once here; the
# runtime tokens are exchanged and stored in instagram_creds.json / facebook_creds.json
# via the Connections page — those files are gitignored and never shown in the UI.
# Create an app at https://developers.facebook.com → Settings → Basic.
FB_APP_ID=1234567890
FB_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── YouTube OAuth client (optional) ──────────────────────────────────────────
# Optional alternative to a client_secret.json file for upload_video.py. If both
# are set here, the OAuth consent flow is built from these instead of the file.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 (Desktop app).
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Optional ─────────────────────────────────────────────────────────────────
# Suppress tqdm progress bars in non-interactive environments.
TQDM_DISABLE=1
