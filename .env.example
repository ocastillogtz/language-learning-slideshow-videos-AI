# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Used by create_script.py to generate dialogue and scene data via GPT.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
# Used by review_manifest.py to proofread the generated script (the "Review
# Script (Claude)" pipeline step). Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── ElevenLabs ───────────────────────────────────────────────────────────────
# Used by create_audio.py to synthesise TTS audio for every scene.
# Get your key at https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=sk_...

# ─── fal.ai ───────────────────────────────────────────────────────────────────
# Used by create_images.py to generate scene illustrations and character/location art.
# Get your key at https://fal.ai → Dashboard → API Keys
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Optional ─────────────────────────────────────────────────────────────────
# Suppress tqdm progress bars in non-interactive environments.
TQDM_DISABLE=1
